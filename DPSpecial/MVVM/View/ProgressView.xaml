<Window x:Class="DPSpecial.MVVM.View.ProgressView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DPSpecial.MVVM.View"
        mc:Ignorable="d"
        Title="RebarProgressView" 
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent"
        Height="100" 
        Width="600">

    <Border Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#ACACAC" Padding="20,0">
        <StackPanel VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock FontWeight="Bold" FontSize="14"
                           Text="{Binding PercenComplete, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock FontWeight="Bold" FontSize="14" Text="%"/>
            </StackPanel>

            <ProgressBar x:Name="myProgressBar"
                         Height="15" 
                         HorizontalAlignment="Stretch"
                         Minimum="0" Maximum="100"
                         Value="{Binding PercenComplete, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </Border>
</Window>