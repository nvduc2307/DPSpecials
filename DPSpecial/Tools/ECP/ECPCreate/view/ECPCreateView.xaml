<Window x:Class="DPSpecial.Tools.ECP.ECPCreate.view.ECPCreateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DPSpecial.Tools.ECP.ECPCreate.view"
        mc:Ignorable="d"
        Title="ECPCreateView" 
        WindowStartupLocation="CenterScreen"
        Height="300" 
        Width="300">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <StackPanel>
                <TextBlock Text="Family"/>
                <ComboBox
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding ECPFamilies}"
                    SelectedItem="{Binding ECPFamily, UpdateSourceTrigger=PropertyChanged}"
                    Height="25"
                    Margin="0,5,0,0"/>
            </StackPanel>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel
                    Margin="0,0,5,0">
                    <TextBlock Text="Width max"/>
                    <TextBox 
                        Text="{Binding ECPWidthMax}"
                        VerticalContentAlignment="Center"
                        Margin="0,5,0,0"
                        IsReadOnly="True"
                        Height="25"/>
                </StackPanel>
                <StackPanel 
                    Margin="5,0,0,0"
                    Grid.Column="1">
                    <TextBlock Text="Width"/>
                    <TextBox 
                        Text="{Binding ECPWidth, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                        VerticalContentAlignment="Center"
                        Margin="0,5,0,0"
                        Height="25"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel
                    Margin="0,0,5,0">
                    <TextBlock Text="Thickness"/>
                    <TextBox 
                        Text="{Binding ECPThickness}"
                        VerticalContentAlignment="Center"
                        Margin="0,5,0,0"
                        IsReadOnly="True"
                        Height="25"/>
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Margin="5,0,0,0">
                    <TextBlock Text="Gap"/>
                    <TextBox 
                        Text="{Binding ECPGap}"
                        VerticalContentAlignment="Center"
                        Margin="0,5,0,0"
                        IsReadOnly="True"
                        Height="25"/>
                </StackPanel>
            </Grid>
        </StackPanel>
        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Grid.Row="1">
            <StackPanel Orientation="Horizontal">
                <Button
                    Command="{Binding OkCommand}"
                    Content="Ok"
                    Width="70"
                    Height="25"/>
                <Button
                    Command="{Binding CancelCommand}"
                    Margin="5,0,0,0"
                    Content="Cancel"
                    Width="70"
                    Height="25"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
