<Window x:Class="DPSpecial.Tools.ECP.ECPCreateScheduleOrderDetail.view.ECPCreateScheduleOrderDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="販売店受注修正[メース一般]"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Background="#F1EFDD"
        FontFamily="MS UI Gothic, Meiryo UI"
        FontSize="12">
    <Window.Resources>
        <SolidColorBrush x:Key="LineBrush" Color="#C9C5B2"/>
        <SolidColorBrush x:Key="PageBrush" Color="#F1EFDD"/>

        <Style x:Key="L" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222222"/>
        </Style>
        <Style x:Key="LR" TargetType="TextBlock" BasedOn="{StaticResource L}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Sec" TargetType="TextBlock" BasedOn="{StaticResource L}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource PageBrush}"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>
        <Style x:Key="F" TargetType="TextBox">
            <Setter Property="Height" Value="19"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#7A0000"/>
            <Setter Property="BorderBrush" Value="#8A8A8A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="1,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
        <Style x:Key="Y" TargetType="TextBox" BasedOn="{StaticResource F}">
            <Setter Property="Background" Value="#FFFF99"/>
        </Style>
        <Style x:Key="Sum" TargetType="TextBox" BasedOn="{StaticResource F}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#7A0000"/>
        </Style>
        <Style x:Key="Box" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="GridHead" TargetType="TextBlock" BasedOn="{StaticResource L}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="FootBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="105"/>
            <Setter Property="Background" Value="#F7F7F7"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SumBtn" TargetType="Button">
            <Setter Property="Height" Value="19"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Background" Value="#F7F7F7"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Width="1267" Height="959" ClipToBounds="True">
        <!-- All coordinates below follow the original 1267 x 994 screen; the canvas is shifted up by the 35px title bar. -->
        <Canvas Width="1267" Height="994" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,-35,0,0">

            <!-- ===== Top line ===== -->
            <TextBlock Style="{StaticResource L}" Canvas.Left="15" Canvas.Top="39" Text="物件登録No."/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="82" Canvas.Top="37" Width="66" Text="{Binding Header.PropertyRegNo, Mode=OneWay}" IsReadOnly="True"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="161" Canvas.Top="39" Text="受注No."/>
            <TextBox Style="{StaticResource F}" Canvas.Left="203" Canvas.Top="37" Width="80" Text="{Binding Header.OrderNo, Mode=OneWay}" IsReadOnly="True"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="297" Canvas.Top="39" Text="営業担当者"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="356" Canvas.Top="37" Width="60" Text="{Binding Header.SalesStaffCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="420" Canvas.Top="37" Width="92" Text="{Binding Header.SalesStaffName}"/>
            <Border Canvas.Left="896" Canvas.Top="36" Width="75" Height="24" BorderBrush="#D00000" BorderThickness="1" Background="White">
                <TextBlock Text="受注処理" Foreground="#D00000" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource Sec}" Canvas.Left="988" Canvas.Top="40" Text="進捗状況"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="1048" Canvas.Top="38" Width="187" Text="{Binding Header.Status}"/>

            <!-- ===== Section frames ===== -->
            <Border Style="{StaticResource Box}" Canvas.Left="10" Canvas.Top="67" Width="955" Height="57"/>
            <Border Style="{StaticResource Box}" Canvas.Left="10" Canvas.Top="131" Width="955" Height="98"/>
            <Border Style="{StaticResource Box}" Canvas.Left="10" Canvas.Top="241" Width="955" Height="51"/>
            <Border Style="{StaticResource Box}" Canvas.Left="10" Canvas.Top="301" Width="955" Height="75"/>
            <Border Style="{StaticResource Box}" Canvas.Left="10" Canvas.Top="385" Width="955" Height="57"/>
            <Border Style="{StaticResource Box}" Canvas.Left="974" Canvas.Top="67" Width="288" Height="55"/>
            <Border Style="{StaticResource Box}" Canvas.Left="974" Canvas.Top="131" Width="288" Height="178"/>
            <Border Style="{StaticResource Box}" Canvas.Left="974" Canvas.Top="323" Width="288" Height="120"/>

            <TextBlock Style="{StaticResource Sec}" Canvas.Left="12" Canvas.Top="59" Text="お客様情報"/>
            <TextBlock Style="{StaticResource Sec}" Canvas.Left="12" Canvas.Top="123" Text="物件情報"/>
            <TextBlock Style="{StaticResource Sec}" Canvas.Left="12" Canvas.Top="233" Text="備考"/>
            <TextBlock Style="{StaticResource Sec}" Canvas.Left="12" Canvas.Top="293" Text="基材情報"/>
            <TextBlock Style="{StaticResource Sec}" Canvas.Left="12" Canvas.Top="377" Text="仕上げ情報"/>
            <TextBlock Style="{StaticResource Sec}" Canvas.Left="982" Canvas.Top="59" Text="希望納期"/>
            <TextBlock Style="{StaticResource Sec}" Canvas.Left="982" Canvas.Top="123" Text="回答納期"/>
            <TextBlock Style="{StaticResource Sec}" Canvas.Left="982" Canvas.Top="315" Text="配車情報"/>

            <!-- ===== お客様情報 ===== -->
            <TextBlock Style="{StaticResource L}" Canvas.Left="27" Canvas.Top="79" Text="販売店"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="82" Canvas.Top="77" Width="70" Text="{Binding Header.DealerCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="152" Canvas.Top="77" Width="245" Text="{Binding Header.DealerName, Mode=OneWay}" IsReadOnly="True"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="398" Canvas.Top="77" Width="245" Text="{Binding Header.DealerBranch}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="654" Canvas.Top="79" Text="担当者"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="700" Canvas.Top="77" Width="127" Text="{Binding Header.DealerContact}"/>

            <!-- ===== 物件情報 ===== -->
            <TextBlock Style="{StaticResource L}" Canvas.Left="22" Canvas.Top="144" Text="物件名称"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="82" Canvas.Top="142" Width="487" Text="{Binding Header.PropertyName, Mode=OneWay}" IsReadOnly="True"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="591" Canvas.Top="144" Text="物件詳細"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="648" Canvas.Top="142" Width="310" Text="{Binding Header.PropertyDetail, Mode=OneWay}" IsReadOnly="True"/>

            <TextBlock Style="{StaticResource L}" Canvas.Left="27" Canvas.Top="165" Text="届け先"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="76" Canvas.Top="165" Text="〒"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="90" Canvas.Top="163" Width="64" Text="{Binding Header.PostalCode}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="172" Canvas.Top="165" Text="都道府県"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="229" Canvas.Top="163" Width="24" Text="{Binding Header.PrefectureCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="253" Canvas.Top="163" Width="50" Text="{Binding Header.PrefectureName}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="317" Canvas.Top="165" Text="住所"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="372" Canvas.Top="163" Width="490" Text="{Binding Header.Address}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="875" Canvas.Top="165" Text="フロア"/>
            <ComboBox Canvas.Left="915" Canvas.Top="163" Width="42" Height="19"/>

            <TextBlock Style="{StaticResource L}" Canvas.Left="258" Canvas.Top="186" Text="施主名"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="310" Canvas.Top="184" Width="150" Text="{Binding Header.OwnerName}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="487" Canvas.Top="186" Text="設計"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="523" Canvas.Top="184" Width="64" Text="{Binding Header.DesignCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="589" Canvas.Top="184" Width="127" Text="{Binding Header.DesignName}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="724" Canvas.Top="186" Text="元請"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="764" Canvas.Top="184" Width="62" Text="{Binding Header.ContractorCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="828" Canvas.Top="184" Width="130" Text="{Binding Header.ContractorName}"/>

            <TextBlock Style="{StaticResource L}" Canvas.Left="21" Canvas.Top="207" Text="工事店"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="83" Canvas.Top="205" Width="65" Text="{Binding Header.ConstructionShopCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="152" Canvas.Top="205" Width="146" Text="{Binding Header.ConstructionShopName}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="319" Canvas.Top="207" Text="荷受人"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="371" Canvas.Top="205" Width="246" Text="{Binding Header.Consignee}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="723" Canvas.Top="207" Text="連絡先"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="764" Canvas.Top="205" Width="125" Text="{Binding Header.ContactPhone}"/>

            <!-- ===== 備考 ===== -->
            <TextBlock Style="{StaticResource L}" Canvas.Left="26" Canvas.Top="249" Text="お客様"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="82" Canvas.Top="247" Width="845" Text="{Binding Header.CustomerNote}"/>

            <!-- ===== 基材情報 ===== -->
            <TextBlock Style="{StaticResource L}" Canvas.Left="33" Canvas.Top="311" Text="用途"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="82" Canvas.Top="309" Width="26" Text="{Binding Header.UseCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="112" Canvas.Top="309" Width="125" Text="{Binding Header.UseName}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="250" Canvas.Top="311" Text="出荷工場"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="299" Canvas.Top="309" Width="30" Text="{Binding Header.FactoryCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="334" Canvas.Top="309" Width="130" Text="{Binding Header.FactoryName}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="498" Canvas.Top="311" Text="区分"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="539" Canvas.Top="309" Width="28" Text="{Binding Header.CategoryCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="569" Canvas.Top="309" Width="248" Text="{Binding Header.CategoryName}"/>

            <TextBlock Style="{StaticResource L}" Canvas.Left="33" Canvas.Top="332" Text="表裏"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="82" Canvas.Top="330" Width="26" Text="{Binding Header.FaceCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="112" Canvas.Top="330" Width="185" Text="{Binding Header.FaceName}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="328" Canvas.Top="332" Text="ｶﾞｽｹｯﾄ貼り"/>
            <RadioButton Canvas.Left="410" Canvas.Top="333" Content="有" GroupName="Gasket" IsChecked="{Binding Header.GasketOn}"/>
            <RadioButton Canvas.Left="462" Canvas.Top="333" Content="無" GroupName="Gasket" IsChecked="{Binding Header.GasketOff}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="572" Canvas.Top="332" Text="ﾋﾞﾆｰﾙ梱包"/>
            <RadioButton Canvas.Left="652" Canvas.Top="333" Content="有" GroupName="Vinyl" IsChecked="{Binding Header.VinylOn}"/>
            <RadioButton Canvas.Left="703" Canvas.Top="333" Content="無" GroupName="Vinyl" IsChecked="{Binding Header.VinylOff}"/>

            <TextBlock Style="{StaticResource L}" Canvas.Left="621" Canvas.Top="353" Text="金物"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="659" Canvas.Top="351" Width="155" Text="{Binding Header.HardwareCode}"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="820" Canvas.Top="351" Width="138" Text="{Binding Header.HardwareName}"/>

            <!-- ===== 仕上げ情報 ===== -->
            <TextBlock Style="{StaticResource L}" Canvas.Left="33" Canvas.Top="398" Text="仕様"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="82" Canvas.Top="396" Width="26" Text="{Binding Header.SpecCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="112" Canvas.Top="396" Width="120" Text="{Binding Header.SpecName}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="487" Canvas.Top="398" Text="塗装種類"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="547" Canvas.Top="396" Width="18" Text="{Binding Header.PaintTypeCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="569" Canvas.Top="396" Width="128" Text="{Binding Header.PaintTypeName}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="725" Canvas.Top="398" Text="色号"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="779" Canvas.Top="396" Width="128" Text="{Binding Header.ColorNo}"/>

            <TextBlock Style="{StaticResource L}" Canvas.Left="36" Canvas.Top="419" Text="艶"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="82" Canvas.Top="417" Width="18" Text="{Binding Header.GlossCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="104" Canvas.Top="417" Width="126" Text="{Binding Header.GlossName}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="251" Canvas.Top="419" Text="ｻﾝﾌﾟﾙNo."/>
            <TextBox Style="{StaticResource F}" Canvas.Left="311" Canvas.Top="417" Width="128" Text="{Binding Header.SampleNo}"/>

            <!-- ===== 希望納期 ===== -->
            <TextBlock Style="{StaticResource L}" Canvas.Left="1017" Canvas.Top="87" Text="希望納期"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="1108" Canvas.Top="85" Width="64" Text="{Binding Header.DesiredDate, Mode=OneWay}" IsReadOnly="True"/>

            <!-- ===== 回答納期 ===== -->
            <TextBlock Style="{StaticResource LR}" Canvas.Left="990" Canvas.Top="147" Width="108" Text="最終出荷日"/>
            <TextBlock Style="{StaticResource LR}" Canvas.Left="990" Canvas.Top="171" Width="108" Text="現場到着予定日"/>
            <TextBlock Style="{StaticResource LR}" Canvas.Left="978" Canvas.Top="195" Width="120" Text="二次加工出荷予定日"/>
            <TextBlock Style="{StaticResource LR}" Canvas.Left="978" Canvas.Top="219" Width="120" Text="二次加工到着予定日"/>
            <TextBlock Style="{StaticResource LR}" Canvas.Left="990" Canvas.Top="243" Width="108" Text="工場出荷予定日"/>
            <TextBlock Style="{StaticResource LR}" Canvas.Left="990" Canvas.Top="267" Width="108" Text="加工開始予定日"/>

            <!-- ===== 配車情報 ===== -->
            <TextBlock Style="{StaticResource L}" Canvas.Left="988" Canvas.Top="337" Text="受渡方法"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="1044" Canvas.Top="335" Width="25" Text="{Binding Header.DeliveryMethodCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="1073" Canvas.Top="335" Width="60" Text="{Binding Header.DeliveryMethodName}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="988" Canvas.Top="359" Text="車両車種"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="1044" Canvas.Top="357" Width="25" Text="{Binding Header.VehicleCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="1073" Canvas.Top="357" Width="60" Text="{Binding Header.VehicleName}"/>
            <TextBox Style="{StaticResource Y}" Canvas.Left="1146" Canvas.Top="357" Width="25" Text="{Binding Header.VehicleTypeCode}"/>
            <TextBox Style="{StaticResource F}" Canvas.Left="1175" Canvas.Top="357" Width="60" Text="{Binding Header.VehicleTypeName}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="987" Canvas.Top="380" Text="梱包制限"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="992" Canvas.Top="392" FontSize="8" Text="(2段積み)"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="1052" Canvas.Top="385" Text="重量"/>
            <TextBox Style="{StaticResource Sum}" Canvas.Left="1086" Canvas.Top="383" Width="38" Text="{Binding Header.LoadWeight}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="1128" Canvas.Top="385" Text="Kg"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="1158" Canvas.Top="385" Text="高さ"/>
            <TextBox Style="{StaticResource Sum}" Canvas.Left="1186" Canvas.Top="383" Width="22" Text="{Binding Header.LoadHeight}"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="1212" Canvas.Top="385" Text="枚"/>
            <TextBlock Style="{StaticResource L}" Canvas.Left="997" Canvas.Top="416" Text="地図"/>
            <RadioButton Canvas.Left="1074" Canvas.Top="417" Content="有" GroupName="Map" IsChecked="{Binding Header.MapOn}"/>
            <RadioButton Canvas.Left="1105" Canvas.Top="417" Content="無" GroupName="Map" IsChecked="{Binding Header.MapOff}"/>

            <!-- ===== Detail grid ===== -->
            <!-- Detail grid: a real DataGrid so rows can be selected and edited -->
            <DataGrid Canvas.Left="5" Canvas.Top="447" Width="940" Height="474"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowHeight="36"
                      SelectionUnit="FullRow"
                      SelectionMode="Single"
                      Background="White"
                      BorderBrush="#9A9A9A"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F3F3"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#B0B0B0"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAlternate}" Value="True">
                                <Setter Property="Background" Value="#CCF8FC"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#9FD8F2"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <!-- Column border: right edge of every cell, plus a bottom edge as the row separator -->
                        <Setter Property="BorderBrush" Value="#B0B0B0"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#222222"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#222222"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Resources>
                    <Style x:Key="CellCenter" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="CellRight" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,2,0"/>
                    </Style>
                    <Style x:Key="EditCenter" TargetType="TextBox">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="EditRight" TargetType="TextBox">
                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="31" Binding="{Binding No}"
                                        ElementStyle="{StaticResource CellCenter}" EditingElementStyle="{StaticResource EditCenter}">
                        <DataGridTextColumn.Header><TextBlock Text="No."/></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="47" Binding="{Binding WorkNo}"
                                        ElementStyle="{StaticResource CellCenter}" EditingElementStyle="{StaticResource EditCenter}">
                        <DataGridTextColumn.Header><TextBlock TextAlignment="Center" Text="施工図&#x0a;No"/></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="162">
                        <DataGridTemplateColumn.Header><TextBlock TextAlignment="Center" Text="商品名&#x0a;製品番号"/></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="3,0,0,0">
                                    <TextBlock Text="{Binding ProductName}" FontSize="11"/>
                                    <TextBlock Text="{Binding PartNumber}" Foreground="#1A1AB0" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" FontSize="11" BorderThickness="0,0,0,1"/>
                                    <TextBox Text="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}" Foreground="#1A1AB0" FontSize="11" BorderThickness="0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="36" Binding="{Binding Length}"
                                        ElementStyle="{StaticResource CellRight}" EditingElementStyle="{StaticResource EditRight}">
                        <DataGridTextColumn.Header><TextBlock TextAlignment="Center" Text="長さ&#x0a;[mm]"/></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="55">
                        <DataGridTemplateColumn.Header><TextBlock TextAlignment="Center" Text="数量&#x0a;[枚]"/></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Quantity}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="{Binding QuantityCode}" Foreground="#1A1AB0" FontSize="11" HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" BorderThickness="0,0,1,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding QuantityCode, UpdateSourceTrigger=PropertyChanged}" Foreground="#1A1AB0" FontSize="11" HorizontalContentAlignment="Center" BorderThickness="0"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="89" IsReadOnly="True">
                        <DataGridTemplateColumn.Header><TextBlock Text="縦切図"/></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Canvas Width="80" Height="28">
                                    <Path Data="M3,7 L12,7 L12,2 L77,2 L77,8 L68,8 L68,20 L77,20 L77,26 L12,26 L12,21 L3,21 Z" Stroke="#333333" StrokeThickness="1" Fill="White">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Profile}" Value="DoubleTongue">
                                                        <Setter Property="Data" Value="M3,7 L12,7 L12,2 L66,2 L66,7 L77,7 L77,21 L66,21 L66,26 L12,26 L12,21 L3,21 Z"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
