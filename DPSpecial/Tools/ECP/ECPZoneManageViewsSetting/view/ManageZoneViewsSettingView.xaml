<Window x:Class="DPSpecial.Tools.ECP.ManageZoneViewsSetting.view.ManageZoneViewsSettingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DPSpecial.Tools.ECP.ManageZoneViewsSetting.view"
        Title="立面図の選択" 
ResizeMode="NoResize"
WindowStartupLocation="CenterScreen"
SizeToContent="Height"
MinHeight="100" 
Width="800">
    <StackPanel Margin="15">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="外壁" HorizontalAlignment="Center"/>
                <DataGrid 
                    Name="_datagridViewElevation"
                    SelectedItem="{Binding SelectedView}"
                    ItemsSource="{Binding Views}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ColumnWidth="*"
                    Height="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn 
                        Binding="{Binding Name}"
                        Header="名称"/>
                        <DataGridTextColumn Header="状態"/>
                        <DataGridTextColumn Header="単独"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Margin="0,5,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Content="合計面数" IsEnabled="False" Margin="0,0,10,0" Height="25" Width="100"/>
                    <Button HorizontalContentAlignment="Left" Content="0" IsEnabled="False" Margin="0,0,10,0" Height="25" Width="50"/>
                    <Button Background="#FE7EFE" Height="25" Width="50"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="間仕切" HorizontalAlignment="Center"/>
                <DataGrid ColumnWidth="*"
                Height="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称"/>
                        <DataGridTextColumn Header="状態"/>
                        <DataGridTextColumn Header="単独"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Margin="0,5,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Content="合計面数" IsEnabled="False" Margin="0,0,10,0" Height="25" Width="100"/>
                    <Button HorizontalContentAlignment="Left" Content="0" IsEnabled="False" Margin="0,0,10,0" Height="25" Width="50"/>
                    <Button Background="#FE7EFE" Height="25" Width="50"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <StackPanel Margin="0,10,0,0">
            <StackPanel
            Orientation="Horizontal" 
            HorizontalAlignment="Stretch">
                <Button Content = "面追加" Margin="0,0,30,0" Height="30" Width="100"/>
                <Button IsEnabled="False" Content = "面複写" Margin="0,0,30,0" Height="30" Width="100"/>
                <Button Content = "面削除" Margin="0,0,30,0" Height="30" Width="100"/>
                <Button Content = "名称変更" Margin="0,0,30,0" Height="30" Width="100"/>
                <Button 
                    Command="{Binding ShowViewCommand}" 
                    Content = "選択" 
                    Margin="0,0,30,0" 
                    Height="30" 
                    Width="100"/>
                <Button 
                    Command="{Binding BackCommand}" 
                    Content = "戻る" 
                    Height="30"
                    Width="100"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
