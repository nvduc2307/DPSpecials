<Window x:Class="DPSpecial.Tools.ECP.ECPZoneInstall.view.ECPZoneInstallView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DPSpecial.Tools.ECP.ECPZoneInstall.view"
        mc:Ignorable="d"
        Title="ECP Zone Install"
        WindowStartupLocation="CenterScreen"
        Height="180"
        Width="300">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Zone"/>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <ComboBox
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Zones}"
                    SelectedItem="{Binding Zone, UpdateSourceTrigger=PropertyChanged}"
                    Height="25"/>
                <Border
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Background="{Binding Zone.Color}"/>
            </Grid>
            <TextBlock
                Margin="0,10,0,0"
                TextWrapping="Wrap"
                Foreground="#666666"
                FontSize="11"
                Text="Pick the ECP elements to tag with this zone one by one. Press Esc to stop picking."/>
        </StackPanel>
        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Grid.Row="1">
            <StackPanel Orientation="Horizontal">
                <Button
                    Command="{Binding OkCommand}"
                    Content="Ok"
                    Width="70"
                    Height="25"/>
                <Button
                    Command="{Binding CancelCommand}"
                    Margin="5,0,0,0"
                    Content="Cancel"
                    Width="70"
                    Height="25"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
